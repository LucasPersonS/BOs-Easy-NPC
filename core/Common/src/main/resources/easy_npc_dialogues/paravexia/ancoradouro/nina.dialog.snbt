        Options:{AllowEscClose:1b,ShowCloseButton:0b,DisplayAvatar:1b},
        Texts:[{Text:"Eles me colocaram no barco e disseram que eu ia ficar curada. Eu nem tava doente. Acho que eles é que estavam."}],
        Buttons:[
