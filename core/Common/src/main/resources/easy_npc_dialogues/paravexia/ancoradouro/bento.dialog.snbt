        Label:"caixa",
        Name:"Bento Arruda",
        Priority:0,
        Options:{AllowEscClose:1b,ShowCloseButton:0b,DisplayAvatar:1b},
        Texts:[{Text:"Faltar, não. Sobrar. Toda manhã aparece uma caixa a mais, com o nosso selo. Ninguém lembra de ter trazido."}],
        Buttons:[
